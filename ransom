Add-Type -AssemblyName PresentationFramework

# Main window
$window = New-Object System.Windows.Window
$window.Title = "SYSTEM INTERFACE"
$window.WindowStyle = "None"
$window.WindowState = "Maximized"
$window.Topmost = $true
$window.Background = [System.Windows.Media.Brushes]::Black
$window.FontFamily = "Consolas"

# Allow ESC to close
$window.Add_KeyDown({
    if ($_.Key -eq "Escape") { $window.Close() }
})

# Root grid
$grid = New-Object System.Windows.Controls.Grid
$window.Content = $grid

# Center panel
$panel = New-Object System.Windows.Controls.StackPanel
$panel.HorizontalAlignment = "Center"
$panel.VerticalAlignment = "Center"
$panel.Width = 600
$grid.Children.Add($panel)

# Title text
$title = New-Object System.Windows.Controls.TextBlock
$title.Text = ">>> ACCESS CONTROL NODE <<<"
$title.Foreground = "Red"
$title.FontSize = 32
$title.Margin = "0,0,0,20"
$title.TextAlignment = "Center"
$panel.Children.Add($title)

# Subtitle
$subtitle = New-Object System.Windows.Controls.TextBlock
$subtitle.Text = "ENTER AUTHORIZATION CODE"
$subtitle.Foreground = "Red"
$subtitle.FontSize = 16
$subtitle.Margin = "0,0,0,20"
$subtitle.TextAlignment = "Center"
$panel.Children.Add($subtitle)

# Input box
$box = New-Object System.Windows.Controls.TextBox
$box.FontSize = 20
$box.Height = 40
$box.Background = "Black"
$box.Foreground = "Red"
$box.BorderBrush = "Red"
$box.CaretBrush = "Red"
$box.HorizontalContentAlignment = "Center"
$box.Margin = "0,0,0,20"
$panel.Children.Add($box)

# Button
$button = New-Object System.Windows.Controls.Button
$button.Content = "AUTHENTICATE"
$button.FontSize = 18
$button.Height = 45
$button.Background = "Black"
$button.Foreground = "Red"
$button.BorderBrush = "Red"
$panel.Children.Add($button)

# Status text
$status = New-Object System.Windows.Controls.TextBlock
$status.Text = ""
$status.Foreground = "Red"
$status.FontSize = 16
$status.Margin = "0,20,0,0"
$status.TextAlignment = "Center"
$panel.Children.Add($status)

# Button logic
$button.Add_Click({
    if ($box.Text -eq "123") {
        [System.Windows.MessageBox]::Show("ACCESS GRANTED.")
        $window.Close()
    } else {
        $status.Text = "ACCESS DENIED"
    }
})

$window.ShowDialog()
